# Set these as environment variables (IDE run configuration or hosting panel).
DB_URL=jdbc:mysql://localhost:3306/typequest_db
DB_USERNAME=root
DB_PASSWORD=change-me

# Base64 string of at least 32 random bytes:  openssl rand -base64 48
TYPEQUEST_JWT_SECRET=

TYPEQUEST_ADMIN_EMAIL=admin@example.com
TYPEQUEST_ADMIN_PASSWORD=use-at-least-12-characters

# On hosts that block SMTP (Render free), set this and ignore MAIL_HOST/PORT/USERNAME/PASSWORD:
BREVO_API_KEY=
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com

# Comma-separated list of frontend origins allowed by CORS
TYPEQUEST_CORS_ALLOWED_ORIGINS=http://localhost:5173
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password

JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Number of reverse proxies in front of the backend (0 if none).
# Use 1 on Render, Railway or Heroku. Leave 0 when running locally.
TYPEQUEST_TRUSTED_PROXY_HOPS=0

# Page the confirmation email links to (your frontend address + /verify-email).
EMAIL_VERIFICATION_BASE_URL=http://localhost:5173/verify-email

# ---- Only for docker compose (see DEPLOY.md) ----
# Public address of the API and the email shown on the privacy page.
PUBLIC_API_URL=http://localhost:8080
CONTACT_EMAIL=contact@your-domain.example
